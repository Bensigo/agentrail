# AgentRail production env — copy to deploy/.env and fill in every REQUIRED
# value before `docker compose -f deploy/docker-compose.prod.yml up -d --build`.
# Referenced by docker-compose.prod.yml's `env_file: ./.env` on every service
# (each service only reads the vars it actually uses; harmless overlap).
#
#   cp deploy/.env.production.example deploy/.env
#
# Every var below was confirmed by reading the actual source that consumes it
# (see the comment above each) — nothing here is guessed. Full setup steps for
# each "you must supply" credential are in deploy/README.md.

# =============================================================================
# Postgres — shared by console (DATABASE_URL) and Jace (WORKFLOW_POSTGRES_URL,
# derived from DATABASE_URL in docker-compose.prod.yml). ONE instance, ONE
# database, for this single-tenant deploy.
# =============================================================================

# REQUIRED. Any strong random string — this becomes the postgres superuser
# password for the `postgres` compose service AND must match the password
# baked into DATABASE_URL below (generate: openssl rand -hex 24).
POSTGRES_PASSWORD=

# Optional — defaults baked into docker-compose.prod.yml if unset.
POSTGRES_USER=agentrail
POSTGRES_DB=agentrail

# REQUIRED. Must use the `postgres` service hostname (compose's internal DNS),
# port 5432, and match POSTGRES_USER/PASSWORD/DB above exactly. Consumed by
# packages/db-postgres/src/migrate.ts (migrations), packages/auth/src/index.ts
# (session store), and re-used by Jace as WORKFLOW_POSTGRES_URL (see
# docker-compose.prod.yml's `jace` service — Eve's @workflow/world-postgres
# state adapter, a DIFFERENT env-var name than this one, verified against that
# package's own README).
DATABASE_URL=postgresql://agentrail:CHANGE_ME@postgres:5432/agentrail

# =============================================================================
# Console (apps/console) — Next.js dashboard + API. Node 24, standalone build.
# =============================================================================

# REQUIRED. Auth.js (next-auth v5) session/JWT signing secret.
# Generate: openssl rand -hex 32
AUTH_SECRET=

# REQUIRED. The Jace GitHub App — YOU MUST REGISTER THIS ONCE. Register at
# https://github.com/settings/apps -> "New GitHub App":
#   Homepage URL:       https://<your-domain>
#   Callback URL:       https://<your-domain>/api/auth/callback/github
#   Setup URL:          https://<your-domain>/api/v1/connectors/github/install-callback
#     ("Redirect on update" checked; Webhook -> Active UNCHECKED)
#   Repository permissions: Contents RW, Pull requests RW, Issues RW,
#     Webhooks RW, Administration RW, Checks RO (Metadata RO is automatic)
#   Organization permissions: Members RO — REQUIRED: the install callback's
#     ownership gate verifies the connecting user is an ORG ADMIN via
#     GET /user/memberships/orgs/{org}; without this permission every org
#     install fails closed with "verify_failed".
#   Account permissions: Email addresses RO
#   "Expire user authorization tokens": UNCHECK — the login-time user token
#     is load-bearing for the install ownership check (GET /user/installations)
#     and this deployment has no user-token refresh path by design; expiring
#     tokens make connects spuriously fail for sessions older than ~8h.
#   Where can it be installed: Any account
# After creating: App ID + slug are on the App page; generate a client
# secret and a private key (.pem) there too. Bot user id:
#   curl -s https://api.github.com/users/<slug>%5Bbot%5D | jq .id
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_BOT_USER_ID=

# REQUIRED. Absolute public origin of the console, e.g. https://<your-domain>
# (no trailing slash). Read by apps/console/lib/channel-dispatch.ts's
# resolveConsolePublicUrl(): the channel dispatcher is a background drain with
# no incoming request to derive an origin from, so it has no other way to
# build a `/connect/<token>` link. Left unset (as it is if you only copy this
# file without filling it in), every `/connect` from an unlinked chat gets the
# generic "couldn't create a connect link" failure copy FOREVER — the
# condition never clears on its own, only setting this var fixes it. Do not
# confuse with AUTH_URL/AUTH_TRUST_HOST above — this is the user-facing origin
# for chat-delivered links, not Auth.js's own config.
CONSOLE_PUBLIC_URL=

# REQUIRED. Encrypts connector secrets (e.g. connector API keys) at rest in
# Postgres (packages/db-postgres/src/crypto.ts, AES-256-GCM). Deliberately
# NOT derived from AUTH_SECRET — different rotation lifecycle. 32+ random
# chars. Generate: openssl rand -hex 32
CONNECTOR_SECRET_KEY=

# Optional but recommended. HMAC-signs the GitHub `issues` webhook
# (apps/console/app/api/v1/connectors/github/webhook/route.ts). Unset =
# signature check is SKIPPED (any POST to the webhook URL is trusted) — set
# this to whatever secret you configure on the repo's webhook (see
# deploy/README.md's GitHub setup step).
GITHUB_WEBHOOK_SECRET=

# Optional. ClickHouse is NOT deployed in this compose file (see
# docker-compose.prod.yml's header comment) — leave unset. Every write path
# that uses it is try/caught (verified: apps/console/app/api/v1/runner/result/route.ts
# swallows ClickHouse insert failures and still returns 202). One exception:
# POST /api/v1/ingest/cost-events returns HTTP 502 if ClickHouse is
# unreachable rather than degrading — a non-critical ancillary ingest path,
# not on the runner's claim/execute/report loop. Leave CLICKHOUSE_URL unset
# unless you stand up ClickHouse yourself. (The hosted Railway deployment is a
# separate target from this compose file and DOES run a self-hosted
# ClickHouse service against these same four vars — see
# deploy/clickhouse/README.md; not applicable to this single-VM skeleton.)
# CLICKHOUSE_URL=
# CLICKHOUSE_USER=
# CLICKHOUSE_PASSWORD=
# CLICKHOUSE_DB=

# Optional. S3/MinIO — B2a §1 (apps/console/lib/artifacts/store.ts) is now
# the console's S3 reader: it backs QA's per-AC evidence screenshots (POST
# /api/v1/runner/review-evidence), which the posted PR review then links
# back as signed GET URLs. Read only when REVIEW_EVIDENCE_ENABLED=1 below —
# leave this whole section and that flag unset/off unless you actually
# stand up an S3-compatible store (MinIO or real S3) for this single-VM
# skeleton; MinIO is intentionally not in this compose file.
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=
# Optional. Defaults to path-style for MinIO. Set to 0 for Railway Buckets,
# whose credentials require virtual-hosted bucket addressing.
# S3_FORCE_PATH_STYLE=0

# Optional. Turns on the review-evidence upload route (POST
# /api/v1/runner/review-evidence) that stores QA's per-AC screenshots.
# Code default is OFF — the route 503s "evidence storage not enabled";
# "1" enables. Enabling this ALSO requires the four S3_* vars above: without
# them, the route's own pre-flight check still 503s cleanly rather than
# crashing, so turning this on alone accomplishes nothing.
# REVIEW_EVIDENCE_ENABLED=1

# Optional. The B2b "boot plane" (docs/superpowers/plans/2026-08-02-b2b-sandbox-boot.md)
# clones a PR head, boots it as a supervised child, and exposes a
# short-lived preview URL for a PR with no existing preview deploy. The
# preview worker (agentrail/runner/preview_worker.py, started as
# `python -m agentrail.runner.preview_worker`) is a NEW out-of-process
# service — separate from the console and from the runner/fleet container
# documented above — and it, together with the browser-sidecar services,
# joins the SAME Railway private network as the rest of the fleet. A booted
# child always binds 0.0.0.0:<port>; only the *.railway.internal host
# (PREVIEW_ADVERTISE_HOST below) is ever advertised back to Jace — nothing
# in this plane is ever bound to a public interface. The whole feature is
# flag-gated (PREVIEW_BOOTS_ENABLED) with per-workspace enrollment
# (PREVIEW_BOOTS_WORKSPACES); both default off, so it is fully inert until
# explicitly turned on.
# Console: gates every /api/v1/runner/preview-boots route; 503 when unset/not "1".
# PREVIEW_BOOTS_ENABLED=1
# Console: comma-separated workspace-id allowlist for preview boots (same idiom as REVIEWER_OF_RECORD_WORKSPACES). Empty/unset = no workspace enrolled.
# PREVIEW_BOOTS_WORKSPACES=
# Console: seconds a claimed preview boot lives before the worker tears it down. Default 720 if unset.
# PREVIEW_BOOT_TTL_SECONDS=
# Preview worker: gate — the process no-ops unless this is exactly "1".
# PREVIEW_WORKER_ENABLED=1
# Preview worker: host embedded in the advertised boot URL — this fleet's own *.railway.internal host in prod (the 127.0.0.1 default is dev-only). Never a public interface.
# PREVIEW_ADVERTISE_HOST=

# Optional. Turns on queue-admission guardrails (prompt-injection screening,
# dedup, per-writer rate limits) at both the Python queue store and the TS
# GitHub-issue webhook. Code default is OFF; "1" enables. See .env.example at
# the repo root for the full rationale. Safe to enable.
# AGENTRAIL_QUEUE_GUARDRAILS_V2=1

# Not set here — pinned directly in docker-compose.prod.yml's `console`
# service because both values are compose-topology-specific, not secrets:
#   EVE_HOST=http://jace:2000        (console -> Jace, internal service DNS)
#   AUTH_TRUST_HOST=true             (required behind Caddy's reverse proxy;
#                                      confirmed via next-auth v5's own deploy
#                                      docs — AUTH_URL itself is NOT needed)

# =============================================================================
# Jace (apps/jace) — Eve/Nitro coordinator sidecar. Node >=24.
# =============================================================================

# REQUIRED by both Console and Jace. Independent service credential for the
# private Console -> Jace hosted-inbound hop. Generate one strong random value
# (for example: openssl rand -hex 32). Missing/blank fails every hosted turn
# closed before Jace reads the request body. This is not an MCP API key and
# must never be supplied as a tool argument.
JACE_HOSTED_INBOUND_TOKEN=

# REQUIRED for OpenRouter routing (apps/jace/agent/lib/model.core.mjs's
# chooseModel(): setting JACE_MODEL_BASE_URL switches Jace off the Vercel AI
# Gateway path onto any OpenAI-compatible endpoint). Fixed value for
# OpenRouter — do not change.
JACE_MODEL_BASE_URL=https://openrouter.ai/api/v1

# REQUIRED. Your OpenRouter API key (https://openrouter.ai/keys) — YOU MUST
# SUPPLY THIS. Sent as the bearer token to JACE_MODEL_BASE_URL.
JACE_MODEL_API_KEY=

# Optional. OpenRouter model slug (no "openrouter/" prefix — Jace's
# @ai-sdk/openai-compatible client hits JACE_MODEL_BASE_URL directly with this
# as the model id). This is Jace's OWN conversational model, independent of
# the runner's coding-agent model routing (deploy/runner/agentrail-config.hosted.json);
# any OpenRouter-listed chat-capable model works.
JACE_MODEL_ID=z-ai/glm-4.6

# Optional. Eve refuses to boot on the OpenAI-compatible path without a
# context-window size (no AI Gateway catalog entry to resolve it from — see
# apps/jace/agent/lib/model.core.mjs). Default 8192 is Ollama-sized and almost
# certainly too small for a real OpenRouter model — set it to your chosen
# model's actual context window (check the model's OpenRouter listing).
JACE_MODEL_CONTEXT_WINDOW_TOKENS=131072

# LEGACY / self-host only. Hosted deployments MUST leave these unset — every
# hosted GitHub call now rides the App installation token (minted per
# workspace from GITHUB_APP_* above; see the spec:
# docs/superpowers/specs/2026-07-24-jace-github-app-identity-design.md).
# A self-hosted single-tenant install MAY still set a PAT here as the CLI's
# explicit-token override (agentrail/cli/commands/issue.py reads it first).
# GITHUB_OAUTH_TOKEN=
# GITHUB_TOKEN=

# REQUIRED. Default owner/repo Jace files created issues into
# (agent/lib/create_issue.core.mjs falls back to this when the tool call
# doesn't pass one explicitly). e.g. "your-org/agentrail".
JACE_TARGET_REPO=

# --- Railway OAuth connect (OAuth Connect Wave 3, one-click connect for the
# Railway observability connector — docs/superpowers/specs/2026-07-31-oauth-
# connect-design.md). Optional; both unset (the default) means the
# connectors sheet shows API-token-paste only for Railway — the permanent
# fallback, unaffected either way. Register a Web (Confidential) OAuth app
# at the target Railway workspace's Settings → Developer → New OAuth App,
# with redirect URI https://<your-domain>/api/v1/connectors/oauth/callback/railway
# (must match CONSOLE_PUBLIC_URL above exactly — trailing slash and scheme
# included). `oauthReady` flips true automatically once both vars below are
# set; no redeploy-time toggle beyond them.
# RAILWAY_OAUTH_CLIENT_ID=
# RAILWAY_OAUTH_CLIENT_SECRET=

# --- Sentry OAuth connect (OAuth Connect Wave 3, one-click connect for the
# Sentry observability connector over Sentry's Public Integration install
# flow — docs/superpowers/specs/2026-07-31-oauth-connect-design.md).
# Optional; all three unset (the default) means the connectors sheet shows
# API-token-paste only for Sentry — the permanent fallback, unaffected
# either way. Sentry's redirect cannot carry a vendor-echoed `state` value
# (doc-confirmed), so tenant binding is resolved by the redeeming session's
# own user id instead of a round-tripped token — see
# apps/console/lib/oauth/sentry.ts's own doc-comment ("SESSION-TRANSPORT
# TENANT BINDING") for the full mechanism. Register a Public Integration at
# Sentry → Settings → Developer Settings → New Public Integration, Redirect
# URL https://<your-domain>/api/v1/connectors/oauth/callback/sentry (must
# match CONSOLE_PUBLIC_URL above exactly), slug from the integration's own
# settings page. `oauthReady` flips true automatically once all three vars
# below are set; no redeploy-time toggle beyond them. ALSO set the
# integration's Webhook URL to
# https://<your-domain>/api/v1/connectors/webhooks/sentry (W3-T5 —
# installation.deleted lifecycle receiver, signs with this SAME client
# secret, no extra var needed).
# SENTRY_OAUTH_CLIENT_ID=
# SENTRY_OAUTH_CLIENT_SECRET=
# SENTRY_OAUTH_INTEGRATION_SLUG=

# --- Cloudflare OAuth connect (OAuth Connect Wave 3, one-click connect for
# the Cloudflare observability connector, W3-T6 — docs/superpowers/specs/
# 2026-07-31-oauth-connect-design.md). Optional; all three unset (the
# default) means the connectors sheet shows API-token-paste only for
# Cloudflare — the permanent fallback, unaffected either way. Register an
# OAuth client at Cloudflare → Manage Account → OAuth clients → Create
# client: Response type "code", Grant type "authorization_code", Token
# authentication method "client_secret_basic" (must match — this adapter
# sends Basic auth), Redirect URL https://<your-domain>/api/v1/connectors/
# oauth/callback/cloudflare (must match CONSOLE_PUBLIC_URL above exactly).
# Search the scopes picker for the permission matching "Analytics Read" under
# Zone permissions (same one the token-paste path's own setup steps ask for)
# — NOT the similarly-named, ALSO-real "Account Analytics Read" (a different,
# account-scoped permission) — and set its scope ID below. Cloudflare does
# not publish this as a fixed string anywhere (see
# apps/console/lib/oauth/cloudflare.ts's own doc-comment, "SCOPES"), so it is
# NOT hardcoded in this codebase; discover it via the scopes picker or
# `GET https://api.cloudflare.com/client/v4/oauth/scopes`. IMPORTANT: new
# OAuth clients default to PRIVATE visibility (only members of the
# registering Cloudflare account can ever authorize) — promote the client to
# PUBLIC (a DNS TXT domain-verification step, up to two days) before any
# OTHER workspace's Cloudflare account can use this connect button — see
# cloudflare.ts's own doc-comment ("PUBLIC vs. PRIVATE CLIENT VISIBILITY").
# `oauthReady` flips true automatically once all three vars below are set; no
# redeploy-time toggle beyond them.
# CLOUDFLARE_OAUTH_CLIENT_ID=
# CLOUDFLARE_OAUTH_CLIENT_SECRET=
# Confirmed 2026-08-01 from the live dashboard's own scopes picker (an
# operator reading, not a vendor-doc citation — see cloudflare.ts's own
# doc-comment, "SCOPES"): the Zone-permissions entry above reads "Analytics
# Read (analytics.read)". Set CLOUDFLARE_OAUTH_SCOPE=analytics.read below;
# verify against your own dashboard picker if it ever errors — this is not a
# vendor-guaranteed-stable string.
# CLOUDFLARE_OAUTH_SCOPE=

# --- Vercel OAuth connect (OAuth Connect Wave 3, one-click connect for the
# Vercel observability connector, W3-T9 — docs/superpowers/specs/2026-07-31-
# oauth-connect-design.md). Optional; all three unset (the default) means
# the connectors sheet shows API-token-paste only for Vercel — the permanent
# fallback, unaffected either way. Vercel access tokens issued this way are
# documented long-lived with NO refresh mechanism (no refresh_token/
# expires_in anywhere in Vercel's own docs for this endpoint) — see
# apps/console/lib/oauth/vercel.ts's own doc-comment, "(3) TOKEN LIFETIME" —
# nothing to rotate, nothing that expires on a clock; the credential is only
# ever invalidated by uninstalling the integration, or IMMEDIATELY if the
# installing team's owner leaves (a 30-day clock then starts toward
# permanent deletion, not toward when the credential first stops working).
# Register a connectable-account Integration at Vercel → your account/team →
# Integrations → Integrations Console → Create
# (vercel.com/d?to=/dashboard/integrations/console). Registering itself
# needs no DNS/domain-verification step (unlike Cloudflare's). Whether the
# RESULTING integration installs right away, even for its own creator, or
# waits on a Vercel-side approval step first is genuinely UNRESOLVED from
# Vercel's own docs — two conflicting passages on the same page, neither
# this task nor its fix round settled which governs (see vercel.ts's own
# doc-comment, "(6) REVIEW / APPROVAL GATE", for the full disclosed
# tension). Try connecting right after registering; if the very first
# attempt fails, wait and retry before assuming a misconfiguration — that
# first attempt is this codebase's own live-smoke test for this question.
# (Vercel's OPTIONAL public marketplace LISTING — a separate, later,
# 500-install-minimum step — is confirmed gated by manual review; this
# connector never needs it, since it links directly rather than going
# through Vercel's own marketplace browse page.) Redirect URL
# https://<your-domain>/api/v1/connectors/oauth/callback/vercel (must match
# CONSOLE_PUBLIC_URL above exactly). API Scopes: select Read for exactly
# `user`, `project`, and `deployment` (least-privilege — this connector
# never writes). Note the issued client id/secret and the integration's own
# URL Slug (from the Create Integration form) — the slug is what makes the
# authorize URL work (vercel.com/integrations/<slug>/new), unlike Railway's/
# Cloudflare's shared-host authorize endpoints. `oauthReady` flips true
# automatically once all three vars below are set; no redeploy-time toggle
# beyond them.
# VERCEL_OAUTH_CLIENT_ID=
# VERCEL_OAUTH_CLIENT_SECRET=
# VERCEL_OAUTH_INTEGRATION_SLUG=

# --- Telegram channel — set these three if you want Jace reachable over
# Telegram (deploy/README.md has the BotFather + setWebhook steps). Optional:
# leave all three unset to skip Telegram entirely.
# Also read by the console itself now (issue #1262 PR ②,
# apps/console/lib/telegram-system-message.ts) for its own system sends (the
# multi-workspace "which workspace is this about?" ask + pin confirmation) —
# same shared hosted bot as the sidecar, one token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Also verified by the shared hosted-bot webhook door (issue #1262,
# apps/console/app/api/v1/connectors/telegram/webhook/route.ts) — one bot, one secret.
TELEGRAM_WEBHOOK_SECRET_TOKEN=
# Optional. Hosted deploys set this (shared bot's @username, no @) so the
# setup wizard shows the deep-link flow instead of a token field; self-hosters
# leave it unset to keep the bring-your-own-bot wizard (issue #1262 PR ③).
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# --- Discord channel — optional, all three or none. Same shared-bot model as
# Telegram above (issue #1284): ONE hosted Discord application/bot, no
# per-workspace tokens. Register the slash command (POST
# /applications/{DISCORD_APPLICATION_ID}/commands) and set the Interactions
# Endpoint URL to https://<host>/api/v1/connectors/discord/webhook — both are
# OWNER ops steps, not something this deploy config alone can do.
# Also read by the console itself (apps/console/lib/discord-bot.ts,
# apps/console/app/api/v1/connectors/discord/webhook/route.ts) — it verifies
# DISCORD_PUBLIC_KEY's Ed25519 signature on every inbound interaction and
# posts system messages (the multi-workspace "which workspace is this
# about?" ask) via DISCORD_BOT_TOKEN — the SAME shared bot Jace's own native
# discord channel (apps/jace/agent/channels/discord.ts) uses, one credential
# set, two processes.
# DISCORD_PUBLIC_KEY=
# DISCORD_APPLICATION_ID=
# DISCORD_BOT_TOKEN=
# Landing card gating (#1284 AC2 — never claim a channel is live before a
# real prod conversation is verified): leave NEXT_PUBLIC_DISCORD_CHANNEL_LIVE
# unset until that verification happens; then set both these to show the
# "Message Jace on Discord" footer link (apps/console/app/(marketing)/_channel-cards.ts).
# The console's own Gateways settings page reads these SAME two vars for its
# Discord card (apps/console/app/(dashboard)/dashboard/[workspaceId]/gateways/
# components/gateway-helpers.ts) — one env contract, two surfaces, so they can
# never disagree about whether Discord is claimable.
# NEXT_PUBLIC_DISCORD_INVITE_URL=
# NEXT_PUBLIC_DISCORD_CHANNEL_LIVE=

# --- Slack channel — one Jace app, MANY per-workspace installs (Task 4,
# docs/superpowers/specs/2026-07-29-slack-multi-workspace-design.md). Each
# workspace that installs Jace gets its OWN bot token, stored encrypted in
# `slack_installations` (via the OAuth install/callback routes) — there is
# deliberately no shared `SLACK_BOT_TOKEN` var anymore: every outbound send,
# console system message and Jace-originated reply alike, resolves the
# posting team's own token by `team_id` (`getSlackInstallation`), never a
# shared default.
# Point the app's Event Subscriptions Request URL at
# https://<host>/api/v1/connectors/slack/events (an owner ops step — Slack
# calls this URL once with a `url_verification` challenge the route must
# echo back before the subscription saves).
# SLACK_SIGNING_SECRET verifies every inbound event's HMAC signature; it is
# per-APP, not per-install, so it stays a single shared var.
# SLACK_SIGNING_SECRET=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# Landing card gating (#1285 AC2 — never claim a channel is live before a
# real prod conversation is verified): leave NEXT_PUBLIC_SLACK_CHANNEL_LIVE
# unset until that verification happens; then set both these to show the
# "Add Jace to Slack" footer link (apps/console/app/(marketing)/_channel-cards.ts).
# The console's own Gateways settings page reads these SAME two vars for its
# Slack card (apps/console/app/(dashboard)/dashboard/[workspaceId]/gateways/
# components/gateway-helpers.ts) — one env contract, two surfaces, so they can
# never disagree about whether Slack is claimable.
# NEXT_PUBLIC_SLACK_INSTALL_URL=
# NEXT_PUBLIC_SLACK_CHANNEL_LIVE=

# --- iMessage channel (LoopMessage) — optional.
# LOOPMESSAGE_API_KEY=
# LOOPMESSAGE_SENDER_NAME=
# LOOPMESSAGE_WEBHOOK_SECRET_TOKEN=
# LOOPMESSAGE_DEFAULT_RECIPIENT=

# Optional. Langfuse Cloud (https://cloud.langfuse.com) — trace/session
# observability for Jace's turns. YOU MUST SUPPLY THESE if you want tracing;
# omit all three to run without it (apps/jace/agent/instrumentation.ts checks
# isLangfuseConfigured() and no-ops otherwise).
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Optional. Lets Jace's fetch_run_evidence / fetch_workspace_memory tools call
# back into the console's API (workspace memory + failure evidence). Needs a
# console-issued API key, which requires a workspace to already exist — set
# these up AFTER first login/workspace creation, not on first boot.
JACE_CONSOLE_BASE_URL=http://console:3000
# Also the B2b preview worker's (agentrail/runner/preview_worker.py) own bearer
# to the console's preview-boots claim/report routes — same token, same
# requireJaceConsoleSecret trust class as every other Jace-coordinator use above.
JACE_CONSOLE_TOKEN=

# Required only for planned R7.2 data or bounded job-readback evidence. Configure the same
# purpose-scoped keyring on the console and Jace services. Key ids must match
# [A-Za-z0-9._-]{1,64}; values are unpadded base64url encodings of exactly 32
# random bytes. Add a replacement key to both services before changing the
# active id, and retain old keys while queued/running review plans reference it.
# REVIEW_DATA_HMAC_ACTIVE_KEY_ID=2026-08-a
# REVIEW_DATA_HMAC_KEYS_JSON={"2026-08-a":"base64url-encoded-32-byte-key"}

# Optional — researcher/qa subagent MCP sidecars. NOT deployed in this compose
# file (see docker-compose.prod.yml's header comment); both subagents degrade
# gracefully when these are unreachable, so leave unset unless you add the
# sidecar services back yourself.
# JACE_PLAYWRIGHT_MCP_URL=
# JACE_AGENT_BROWSER_MCP_URL=
# JACE_BROWSER_USE_MCP_URL=
# BROWSER_USE_LLM_KEY=
# CONTEXT7_API_KEY=

# =============================================================================
# Runner (deploy/runner/) — the headless coding agent (Claude Code) that
# claims queued issues and executes them via OpenRouter. See
# deploy/runner/README.md for the full env contract and
# deploy/runner/Dockerfile's header comment for the execution-mode decision.
# =============================================================================

# REQUIRED. Your OpenRouter API key — can be the SAME key as JACE_MODEL_API_KEY
# above (same provider) or a separate one if you want separate billing/limits.
# Mapped by deploy/runner/entrypoint.sh into ANTHROPIC_AUTH_TOKEN at container
# start (Claude Code's own env var for a Bearer-style credential) — never
# baked into the image, never logged.
OPENROUTER_API_KEY=

# NOT listed here on purpose: a single RUNNER_MODEL var. Model routing is now
# per-target-repo, per-phase (execute/verify/critic), via that repo's own
# .agentrail/config.json — see deploy/runner/agentrail-config.hosted.json for
# the reference template and why. There is no one blanket "the coding
# model" setting anymore.
#
# NOT listed here on purpose: ANTHROPIC_API_KEY. Do not set it for the runner
# service — its mere presence flips agentrail's sandbox-selection logic into
# Docker-sandbox mode, which this deploy does not provision (no
# /var/run/docker.sock mount). See deploy/runner/Dockerfile.
