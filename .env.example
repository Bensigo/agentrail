# Postgres
DATABASE_URL=postgresql://agentrail:agentrail@localhost:5432/agentrail

# ClickHouse
CLICKHOUSE_URL=http://agentrail:agentrail@localhost:8123/agentrail

# MinIO / S3-compatible object storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=agentrail
S3_SECRET_KEY=agentrail123
S3_BUCKET=agentrail-artifacts

# Auth.js (generate with: openssl rand -hex 32)
AUTH_SECRET=your-auth-secret-here

# Absolute public origin of the console, e.g. https://www.heyjace.com (must be
# the CANONICAL host — the apex 301s to www in production, and webhook POSTs
# do not survive that redirect). Required
# for /connect links: the channel dispatcher is a background drain with no
# incoming request to derive an origin from.
CONSOLE_PUBLIC_URL=

# Jace GitHub App (register at https://github.com/settings/apps — see the
# deploy example for the full registration checklist). ONE App serves both
# console login (client id/secret below) and repo access (App id + private
# key, read by @agentrail/github-app).
# Login callback URL on the App: http://localhost:3000/api/auth/callback/github
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Full PEM contents of the App's private key (literal \n newlines are OK).
GITHUB_APP_PRIVATE_KEY=
# Numeric user id of <slug>[bot] — curl https://api.github.com/users/<slug>%5Bbot%5D | jq .id
GITHUB_APP_BOT_USER_ID=

# Optional. One-click OAuth connect for the Railway connector (OAuth Connect
# Wave 3, docs/superpowers/specs/2026-07-31-oauth-connect-design.md). Absent =
# the connectors sheet shows API-token-paste only (unchanged, permanent
# fallback) — nothing breaks without these. Register a Web (Confidential)
# OAuth app at your Railway workspace's Settings → Developer → New OAuth App,
# with redirect URI http://localhost:3000/api/v1/connectors/oauth/callback/railway
# (swap the origin for CONSOLE_PUBLIC_URL above in non-local dev).
RAILWAY_OAUTH_CLIENT_ID=
RAILWAY_OAUTH_CLIENT_SECRET=

# Optional. One-click OAuth connect for the Sentry connector, over Sentry's
# Public Integration install flow (OAuth Connect Wave 3, W3-T3). Absent =
# the connectors sheet shows API-token-paste only (unchanged, permanent
# fallback) — nothing breaks without these. Sentry's redirect cannot carry
# a vendor-echoed `state` value (doc-confirmed), so tenant binding is
# resolved by the redeeming session's own user id instead — see
# apps/console/lib/oauth/sentry.ts's own doc-comment ("SESSION-TRANSPORT
# TENANT BINDING") for the full mechanism. Register a Public Integration at
# Sentry → Settings → Developer Settings → New Public Integration, with
# Redirect URL http://localhost:3000/api/v1/connectors/oauth/callback/sentry
# (swap the origin for CONSOLE_PUBLIC_URL above in non-local dev). All
# THREE vars below gate `oauthReady` for sentry — the slug comes from the
# integration's own settings page. ALSO set the integration's Webhook URL
# to http://localhost:3000/api/v1/connectors/webhooks/sentry (same origin
# swap; W3-T5) — it signs with this SAME client secret, no extra var.
SENTRY_OAUTH_CLIENT_ID=
SENTRY_OAUTH_CLIENT_SECRET=
SENTRY_OAUTH_INTEGRATION_SLUG=

# Optional. One-click OAuth connect for the Cloudflare connector (OAuth
# Connect Wave 3, W3-T6). Absent = the connectors sheet shows API-token-paste
# only — unchanged, permanent fallback — nothing breaks without these.
# Register an OAuth client at Cloudflare → Manage Account → OAuth clients →
# Create client (dash.cloudflare.com/?to=/:account/oauth-clients): Response
# type "code", Grant type "authorization_code", Token authentication method
# "client_secret_basic" (must match — this adapter sends Basic auth), Redirect
# URL http://localhost:3000/api/v1/connectors/oauth/callback/cloudflare (swap
# the origin for CONSOLE_PUBLIC_URL above in non-local dev). Search the scopes
# picker for the permission matching "Zone Analytics Read" (the same one the
# token-paste path's own setup steps ask for) and set its scope ID below —
# Cloudflare does not publish this as a fixed string anywhere (see
# apps/console/lib/oauth/cloudflare.ts's own doc-comment, "SCOPES"), so it is
# NOT hardcoded in this codebase. IMPORTANT: new OAuth clients default to
# PRIVATE visibility (only members of the registering Cloudflare account can
# ever authorize) — you must promote the client to PUBLIC (requires a DNS TXT
# domain-verification step that can take up to two days) before any other
# workspace's Cloudflare account can use this connect button. See
# cloudflare.ts's own doc-comment ("PUBLIC vs. PRIVATE CLIENT VISIBILITY").
CLOUDFLARE_OAUTH_CLIENT_ID=
CLOUDFLARE_OAUTH_CLIENT_SECRET=
CLOUDFLARE_OAUTH_SCOPE=

# AFK pipeline / server link
# These three vars are injected by the afk runner into each worktree so that
# snapshot_push.py can reach the dashboard ingest endpoints when no
# .agentrail/server.json is present (e.g. inside an afk worktree).
AGENTRAIL_SERVER_BASE_URL=http://localhost:3000   # base URL of the AgentRail server
AGENTRAIL_SERVER_API_KEY=your-api-key-here        # API key for authenticating with the server
AGENTRAIL_SERVER_REPOSITORY_ID=your-repo-id-here  # repository ID the run is associated with

# Input-Contract v2 queue-entrance guardrails (#1022 / #1026 / #1034)
# Turns ON the queue-admission guardrails at BOTH entrances — the Python queue
# store (heartbeat `run`/`serve`) and the TS webhook (`enqueueGithubIssue`):
# prompt-injection screening, duplicate-content dedup, and per-writer rate limits.
# The code default is OFF (rollout safety); set this to "1" to enable it per
# environment (reversible — unset or "0" restores the legacy path byte-for-byte).
# Safe to enable: an injection/dup/rate-limit hit PARKS a durable, human-reviewable
# queue row — it never DROPS a legitimate issue on the live path. Note: the
# rate-limit ledger is per long-lived process (no time-window reset yet), so a
# very high-volume writer can accumulate parks over a long daemon uptime; those are
# recoverable (unpark), not lost. Validate before flipping in prod with:
#   PYTHONPATH=$(pwd) python3 agentrail/scripts/validate-input-contract-v2.py
AGENTRAIL_QUEUE_GUARDRAILS_V2=1

# Stripe subscriptions (subscription slice 3 plan,
# docs/superpowers/plans/2026-07-29-subscription-stripe-slice3.md). Plans and
# their entitlements live in code (lib/policy/plan-policies.ts) — these are
# only the Stripe-side ids/secrets. All four unset in dev: checkout/webhook
# degrade gracefully rather than erroring (lib/stripe.ts's isStripeConfigured()).
STRIPE_SECRET_KEY=       # Stripe API secret key (sk_test_... / sk_live_...)
STRIPE_WEBHOOK_SECRET=   # signing secret for the /api/v1/billing/stripe/webhook endpoint (whsec_...)
STRIPE_PRICE_STARTER=    # recurring Price id for the Starter plan ($80/mo, 4 seats)
STRIPE_PRICE_GROWTH=     # recurring Price id for the Growth plan ($200/mo, 10 seats)
